geom_density(alpha = 0.7) +
facet_wrap(~ Chromosome, ncol = 2, scales = "free_x") +
scale_fill_manual(values = friendly_palette) +
labs(
title = "Teosinte SNP Distribution Across Chromosomes",
x = "Position", y = "Density"
) +
theme_light() +
theme(legend.position = "none")
# Load datasets
maize <- fread("Common_files/maize_data.txt", sep = "\t", header = TRUE)
teosinte <- fread("Common_files/teosinte_data.txt", sep = "\t", header = TRUE)
# Convert to tidy (long) format
maize_long <- maize %>%
pivot_longer(cols = -(c(SNP_ID, Chromosome, Position)), names_to = "Sample_ID", values_to = "Genotype") %>%
filter(!(Chromosome %in% c("unknown", "multiple"))) %>%
mutate(Position = as.numeric(Position),
Chromosome = sprintf("%02d", as.numeric(Chromosome)),
Group = "Maize")
teosinte_long <- teosinte %>%
pivot_longer(cols = -(c(SNP_ID, Chromosome, Position)), names_to = "Sample_ID", values_to = "Genotype") %>%
filter(!(Chromosome %in% c("unknown", "multiple"))) %>%
mutate(Position = as.numeric(Position),
Chromosome = sprintf("%02d", as.numeric(Chromosome)),
Group = "Teosinte")
# Combine both groups
combined_long <- bind_rows(maize_long, teosinte_long)
# Create color palette
friendly_palette <- viridis(10, option = "C")
# Plot: Maize
ggplot(filtered_maize_snp, aes(x = as.numeric(Position), fill = Chromosome)) +
geom_density(alpha = 0.8) +
facet_wrap(~ Chromosome, ncol = 5, scales = "free") +   # Updated facet_wrap
scale_y_continuous(n.breaks = 4) +                       # Limit y-axis ticks
scale_fill_manual(values = friendly_palette) +
theme_light() +
labs(x = "Chromosome Position", y = "SNP Density",
title = "Maize Distribution of SNPs Across Chromosomes") +
theme(
legend.position = "none",
axis.text.y = element_text(size = 8)                  # Shrink y-axis text
)
