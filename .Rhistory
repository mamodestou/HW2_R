# Load genotypes and SNP position data
fang <- read_tsv("Common_files/fang_et_al_genotypes.txt")
snp_pos <- read_tsv("Common_files/snp_position.txt")
# Filter only for Maize and Teosinte groups
fang <- fang %>% filter(Group %in% c("ZMMIL", "ZMMLR", "ZMMMR", "ZMPBA", "ZMPIL", "ZMPJA"))
# Make genotype data long (1 row per SNP per sample)
tidy_fang <- fang %>%
pivot_longer(
cols = -c(Sample_ID, Group, JG_OTU),
names_to = "SNP_ID",
values_to = "Genotype"
)
# Merge with SNP position data to get chromosome info
tidy_with_chr <- merge(tidy_fang, snp_pos[, c("SNP_ID", "Chromosome")], by = "SNP_ID")
# Add a column indicating Maize or Teosinte
tidy_with_chr <- tidy_with_chr %>%
mutate(type = if_else(Group %in% c("ZMMIL", "ZMMLR", "ZMMMR"), "Maize", "Teosinte"))
# Pad chromosome numbers with leading zeros but keep "unknown"/"multiple"
tidy_with_chr$Chromosome <- ifelse(
tidy_with_chr$Chromosome %in% c("unknown", "multiple"),
tidy_with_chr$Chromosome,
sprintf("%02d", as.numeric(tidy_with_chr$Chromosome))
)
# Count SNPs for each of the maize and teosinte chromosomes
snps_per_chr <- tidy_with_chr %>%
group_by(Chromosome, type) %>%
summarise(n = n(), .groups = "drop")
# Plot
ggplot(snps_per_chr, aes(x = Chromosome, y = n, fill = type)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.8), width = 0.7) +
scale_fill_manual(values = c("Maize" = "#1f77b4", "Teosinte" = "#ff7f0e")) +
scale_y_continuous(labels = scales::scientific) +
labs(
title = "SNP Count by Chromosome",
subtitle = "Comparison between Maize and Teosinte",
x = "Chromosome",
y = "Number of SNPs",
fill = "Group"
) +
coord_cartesian(clip = "off") +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(size = 16, face = "bold", hjust = 0.5),
plot.subtitle = element_text(size = 12, hjust = 0.5, color = "gray40"),
axis.text.x = element_text(angle = 45, hjust = 1),
axis.text.y = element_text(size = 10),
legend.position = "top",
legend.title = element_text(face = "bold")
)
# Load genotype and SNP position data
fang <- read_tsv("Common_files/fang_et_al_genotypes.txt")
snp_pos <- read_tsv("Common_files/snp_position.txt")
# Pivot genotype data to long format
tidy_fang <- fang %>%
pivot_longer(
cols = -c(Sample_ID, Group, JG_OTU),
names_to = "SNP_ID",
values_to = "Genotype"
)
# Merge with SNP position data to get Chromosome and Position info
tidy_with_chr <- tidy_fang %>%
left_join(snp_pos %>% select(SNP_ID, Chromosome, Position), by = "SNP_ID")
# Remove 'unknown' and 'multiple' chromosomes
tidy_with_chr <- tidy_with_chr %>%
filter(!Chromosome %in% c("unknown", "multiple"))
# Convert Position to numeric and pad Chromosome
tidy_with_chr <- tidy_with_chr %>%
mutate(
Position = suppressWarnings(as.numeric(Position)),
Chromosome = if_else(
Chromosome %in% c("unknown", "multiple"),
Chromosome,
sprintf("%02d", as.numeric(Chromosome))
)
)
# Define type (Maize or Teosinte) based on Group
tidy_with_chr <- tidy_with_chr %>%
mutate(type = case_when(
Group %in% c("ZMMIL", "ZMMLR", "ZMMMR") ~ "Maize",
Group %in% c("ZMPBA", "ZMPIL", "ZMPJA") ~ "Teosinte",
TRUE ~ NA_character_
)) %>%
filter(!is.na(type))  # Remove samples that are not in either group
# Plot: SNP distribution per chromosome
ggplot(tidy_with_chr, aes(x = Position, fill = Chromosome)) +
geom_density(alpha = 0.6) +
facet_wrap(~ Chromosome, ncol = 2, scales = "free_x") +
theme_minimal() +
labs(
title = "SNP Distribution Across Chromosomes",
x = "Genomic Position",
y = "Density"
) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none"
)
